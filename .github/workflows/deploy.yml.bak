name: "Proxmox Terraform Deploy"

on:
  push:
    branches:
      - main

jobs:
  terraform:
    name: "Terraform Apply"
    runs-on: self-hosted # <--- Forces the job to run inside your home LXC
    
    env:
      # Map GitHub secrets to environment variables that Terraform recognizes
      TF_VAR_pm_api_url: ${{ secrets.PM_API_URL }}
      TF_VAR_pm_api_token_id: ${{ secrets.PM_API_TOKEN_ID }}
      TF_VAR_pm_api_token_secret: ${{ secrets.PM_API_TOKEN_SECRET }}
      TF_VAR_container_root_password: ${{ secrets.TF_VAR_container_root_password }}

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # Links the existing tracking file from the permanent local disk partition
      - name: Link Persistent State File
        run: |
          mkdir -p /home/github/persistent-tf-state
          if [ -f /home/github/persistent-tf-state/terraform.tfstate ]; then
            ln -sf /home/github/persistent-tf-state/terraform.tfstate ./terraform.tfstate
            echo "✅ Swapped in existing persistent state tracking file."
          fi

      - name: Terraform Init
        run: terraform init

      - name: Terraform Plan
        run: terraform plan

      - name: Terraform Apply
        run: terraform apply -auto-approve

      # FIX: Removed the broken 'cp' command. If a new state was generated, 
      # copy it only if it's a real file, otherwise break the link cleanly.
      - name: Save State Post-Apply
        if: always()
        run: |
          if [ -f ./terraform.tfstate ] && [ ! -L ./terraform.tfstate ]; then
            cp -f ./terraform.tfstate /home/github/persistent-tf-state/terraform.tfstate
            echo "💾 Securely stored new state metadata onto persistent disk."
          elif [ -L ./terraform.tfstate ]; then
            rm -f ./terraform.tfstate
            echo "✅ Persistent state verified and link cleaned up safely."
          fi
